rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function sensitiveUserFieldsChanged() {
      return request.resource.data.diff(resource.data).changedKeys().hasAny([
        'plan',
        'premium',
        'usage',
        'cost',
        'freeGenerationsUsed',
        'freeGenerationsLimit'
      ]);
    }

    function currentFreeGenerationsUsed() {
      return resource.data.keys().hasAny(['freeGenerationsUsed'])
        ? resource.data.freeGenerationsUsed
        : 0;
    }

    function currentFreeGenerationsLimit() {
      return resource.data.keys().hasAny(['freeGenerationsLimit'])
        ? resource.data.freeGenerationsLimit
        : 5;
    }

    function consumesOneFreeGeneration() {
      let used = currentFreeGenerationsUsed();
      let limit = currentFreeGenerationsLimit();
      return !(resource.data.premium == true || resource.data.plan == 'premium')
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'freeGenerationsUsed',
          'freeGenerationsLimit',
          'updatedAt'
        ])
        && request.resource.data.freeGenerationsUsed == used + 1
        && request.resource.data.freeGenerationsLimit == limit
        && used < limit;
    }

    match /users/{uid} {
      allow read: if owns(uid);
      allow create: if owns(uid)
        && !request.resource.data.keys().hasAny([
          'plan',
          'premium',
          'usage',
          'cost',
          'freeGenerationsUsed',
          'freeGenerationsLimit'
        ]);
      allow update: if owns(uid)
        && (!sensitiveUserFieldsChanged() || consumesOneFreeGeneration());
      allow delete: if false;

      match /decks/{deckId} {
        allow read, create, update: if owns(uid);
        allow delete: if false;

        match /cards/{cardId} {
          allow read, create, update: if owns(uid);
          allow delete: if false;
        }
      }

      match /usage/{period} {
        allow read: if owns(uid);
        allow write: if false;
      }
    }
  }
}
