rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function sensitiveUserFieldsChanged() {
      return request.resource.data.diff(resource.data).changedKeys().hasAny([
        'plan',
        'premium',
        'usage',
        'cost',
        'aiUsage',
        'aiBillingAnchorMs',
        'aiMonthlyBudgetMicroUSD',
        'freeGenerationsUsed',
        'freeGenerationsLimit'
      ]);
    }

    match /users/{uid} {
      allow read: if owns(uid);
      allow create: if owns(uid)
        && !request.resource.data.keys().hasAny([
          'plan',
          'premium',
          'usage',
          'cost',
          'aiUsage',
          'aiBillingAnchorMs',
          'aiMonthlyBudgetMicroUSD',
          'freeGenerationsUsed',
          'freeGenerationsLimit'
        ]);
      allow update: if owns(uid)
        && !sensitiveUserFieldsChanged();
      allow delete: if false;

      match /decks/{deckId} {
        allow read, create, update: if owns(uid);
        allow delete: if false;

        match /cards/{cardId} {
          allow read, create, update: if owns(uid);
          allow delete: if false;

          match /reviewEvents/{eventId} {
            allow read, create, update: if owns(uid);
            allow delete: if false;
          }
        }
      }

      match /folders/{folderId} {
        allow read, create, update: if owns(uid);
        allow delete: if false;
      }

      match /homeDailyStudy/{dayKey} {
        allow read, create, update: if owns(uid);
        allow delete: if false;
      }

      match /homeDailyDecks/{rowId} {
        allow read, create, update: if owns(uid);
        allow delete: if false;
      }

      match /homeDailyCards/{rowId} {
        allow read, create, update: if owns(uid);
        allow delete: if false;
      }

      match /usage/{period} {
        allow read: if owns(uid);
        allow write: if false;
      }

      match /usageEvents/{generationId} {
        allow read, write: if false;
      }
    }
  }
}
